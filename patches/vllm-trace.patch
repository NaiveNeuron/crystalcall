     # ------------------------------------------------------------------
+    # CrystalCall trace emission
+    # ------------------------------------------------------------------
+
+    def _emit_trace(
+        self,
+        decode_slots: torch.Tensor,
+        step_pre: torch.Tensor,
+        is_committing: torch.Tensor,
+        decode_slots_np: np.ndarray,
+        valid_canvas_len_np: np.ndarray,
+    ) -> None:
+        """Stage one revision batch without waiting for host visibility.
+
+        The sampler only performs non-blocking copies into a persistent pinned
+        ring and records a CUDA event.  ``crystalcall_trace`` owns the bounded
+        staging queue; its worker waits for the event and materialises Python
+        lists.  Thus neither event synchronisation nor ``.tolist()`` runs on
+        the denoise thread.
+        """
+        states = self.diffusion_states
+        sample_ns = time.monotonic_ns()
+        # Post-step is_encoder_phase == "commits next" == converged.
+        converged_after = states.is_encoder_phase[decode_slots]
+        payload = crystalcall_trace.want_payload()
+        n = int(decode_slots.shape[0])
+        if n == 0:
+            return
+
+        slot = self._trace_stage_acquire()
+        if slot is None:
+            # A dropped commit would otherwise make the worker assign every
+            # later revision the wrong canvas id.  Mark the request unusable
+            # rather than emitting a plausible but corrupted trace.
+            for req_slot in decode_slots_np[:n]:
+                rec = _TRACE_SLOTS.get(int(req_slot))
+                if rec is not None:
+                    rec.desynced = True
+            crystalcall_trace.note_drop()
+            return
+        buf = self._trace_ring[slot]
+
+        # Narrow dtypes: token ids fit int32 (vocab 262144) and the accept mask
+        # is 0/1, so both shrink 8x -> 4x and 8x -> 1x.  Confidence and entropy
+        # stay float32 so the tau comparison in the launch gate is bit-for-bit
+        # what the sampler computed.
+        if payload:
+            buf["tokens"][:n].copy_(
+                states.argmax_canvas[decode_slots].to(torch.int32), non_blocking=True
+            )
+            buf["mask"][:n].copy_(
+                states.trace_accept_mask[decode_slots].to(torch.uint8), non_blocking=True
+            )
+            buf["conf"][:n].copy_(states.trace_token_conf[decode_slots], non_blocking=True)
+            buf["entropy"][:n].copy_(
+                states.trace_token_entropy[decode_slots], non_blocking=True
+            )
+        scal = torch.stack(
+            (
+                step_pre.to(torch.int32),
+                converged_after.to(torch.int32),
+                is_committing.to(torch.int32),
+            ),
+            dim=1,
+        )
+        buf["scalars"][:n].copy_(scal, non_blocking=True)
+        buf["mean_entropy"][:n].copy_(
+            states.trace_mean_entropy[decode_slots], non_blocking=True
+        )
+        buf["event"].record()
+        buf["n"] = n
+        buf["payload"] = payload
+        buf["sample_ns"] = sample_ns
+        # Request records are consumed only by the single stage worker, in
+        # queue order, so mutable canvas counters cannot race this sampler.
+        buf["recs"] = [_TRACE_SLOTS.get(int(x)) for x in decode_slots_np[:n]]
+        buf["valid_lens"] = [int(x) for x in valid_canvas_len_np[:n]]
+
+        if not crystalcall_trace.defer_staged(buf):
+            # The emitter counted the queue drop.  Mark every request in the
+            # batch desynchronised before releasing the pinned slot.
+            for rec in buf["recs"]:
+                if rec is not None:
+                    rec.desynced = True
+            buf["busy"] = False
+            buf["recs"] = None
+
+    def _trace_stage_acquire(self):
+        """Reserve a pinned staging slot, allocating the ring on first use."""
+        if self._trace_ring is None:
+            depth = crystalcall_trace.ring_depth()
+            rows = int(self.diffusion_states.argmax_canvas.shape[0])
+            CL = self.canvas_length
+            ring = []
+            for _ in range(depth):
+                ring.append(
+                    {
+                        "tokens": torch.empty((rows, CL), dtype=torch.int32, pin_memory=True),
+                        "mask": torch.empty((rows, CL), dtype=torch.uint8, pin_memory=True),
+                        "conf": torch.empty((rows, CL), dtype=torch.float32, pin_memory=True),
+                        "entropy": torch.empty(
+                            (rows, CL), dtype=torch.float32, pin_memory=True
+                        ),
+                        "scalars": torch.empty((rows, 3), dtype=torch.int32, pin_memory=True),
+                        "mean_entropy": torch.empty(
+                            (rows,), dtype=torch.float32, pin_memory=True
+                        ),
+                        "event": torch.cuda.Event(),
+                        "busy": False,
+                        "n": 0,
+                        "recs": None,
+                    }
+                )
+            self._trace_ring = ring
+        for i, b in enumerate(self._trace_ring):
+            if not b["busy"]:
+                b["busy"] = True
+                return i
+        return None
+
+    def flush_trace(self) -> None:
+        """Wait for staged revisions before a request record is discarded."""
+        if self._trace_on:
+            crystalcall_trace.flush_staged()
+
